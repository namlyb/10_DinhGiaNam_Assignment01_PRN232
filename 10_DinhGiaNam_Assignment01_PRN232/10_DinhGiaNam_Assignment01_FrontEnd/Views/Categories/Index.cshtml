@model List<CategoryVm>
<h1>Category Management</h1><div class="toolbar"><form class="search"><input name="search" value="@ViewBag.Search" placeholder="Search category"/><button>Search</button></form><button onclick="openDlg('create')">+ Create category</button></div>
<table><thead><tr><th>ID</th><th>Name</th><th>Description</th><th>Parent</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.CategoryId</td><td>@c.CategoryName</td><td>@c.CategoryDesciption</td><td>@c.ParentCategoryId</td><td>@(c.IsActive?"Active":"Inactive")</td><td><button onclick="openDlg('e@c.CategoryId')">Edit</button><form class="inline" method="post" asp-action="Delete" onsubmit="return confirmDelete()"><input type="hidden" name="id" value="@c.CategoryId"/><button class="danger">Delete</button></form></td></tr>
<dialog id="e@c.CategoryId"><form method="post" asp-action="Edit"><input type="hidden" name="CategoryId" value="@c.CategoryId"/><h2>Edit category</h2><label>Name<input name="CategoryName" value="@c.CategoryName" required/></label><label>Description<textarea name="CategoryDesciption" required>@c.CategoryDesciption</textarea></label><label>Parent ID<input type="number" name="ParentCategoryId" value="@c.ParentCategoryId"/></label><label class="check"><input type="checkbox" name="IsActive" value="true" checked="@(c.IsActive ? "checked" : null)"/> Active</label><div class="dlg-actions"><button type="button" onclick="closeDlg('e@c.CategoryId')">Cancel</button><button>Save</button></div></form></dialog>}
</tbody></table>
<dialog id="create"><form method="post" asp-action="Create"><h2>Create category</h2><label>Name<input name="CategoryName" required maxlength="100"/></label><label>Description<textarea name="CategoryDesciption" required maxlength="250"></textarea></label><label>Parent ID<input type="number" name="ParentCategoryId"/></label><label class="check"><input type="checkbox" name="IsActive" value="true" checked/> Active</label><div class="dlg-actions"><button type="button" onclick="closeDlg('create')">Cancel</button><button>Create</button></div></form></dialog>
