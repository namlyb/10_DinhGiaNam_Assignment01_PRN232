@model LoginVm
<div class="loginbox"><h1>Sign in</h1>@if(ViewBag.Error!=null){<div class="alert error">@ViewBag.Error</div>}<form method="post"><label>Email<input asp-for="Email"/></label><span asp-validation-for="Email"></span><label>Password<input asp-for="Password" type="password"/></label><span asp-validation-for="Password"></span><button>Login</button></form><p class="hint">Admin account comes from BackEnd appsettings.json.</p></div>
