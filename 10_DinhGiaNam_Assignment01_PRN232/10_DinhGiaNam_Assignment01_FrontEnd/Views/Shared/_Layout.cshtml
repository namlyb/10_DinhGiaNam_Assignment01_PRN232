<!DOCTYPE html>
<html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>FU News Management</title><link rel="stylesheet" href="~/css/site.css"/></head>
<body>
<header><a class="brand" asp-controller="Home" asp-action="Index">FU News Management</a><nav>
<a asp-controller="Home" asp-action="Index">Public News</a>
@if (Context.Session.GetString("Role") == "Admin") { <a asp-controller="Accounts" asp-action="Index">Accounts</a><a asp-controller="Report" asp-action="Index">Report</a> }
@if (Context.Session.GetString("Role") == "Staff") { <a asp-controller="Categories" asp-action="Index">Categories</a><a asp-controller="News" asp-action="Index">News</a><a href="/News?history=true">My History</a><a asp-controller="Profile" asp-action="Index">Profile</a> }
@if (string.IsNullOrEmpty(Context.Session.GetString("Role"))) { <a asp-controller="Auth" asp-action="Login">Login</a> } else { <span class="who">@Context.Session.GetString("Name") (@Context.Session.GetString("Role"))</span><a asp-controller="Auth" asp-action="Logout">Logout</a> }
</nav></header>
<main class="container">
@if (TempData["Ok"] != null) { <div class="alert ok">@TempData["Ok"]</div> }
@if (TempData["Error"] != null) { <div class="alert error">@TempData["Error"]</div> }
@RenderBody()</main>
<script>function openDlg(id){document.getElementById(id).showModal()} function closeDlg(id){document.getElementById(id).close()} function confirmDelete(){return confirm('Are you sure you want to delete this item?')}</script>
</body></html>
