@model NewsPageVm
<h1>News Article Management</h1><div class="toolbar"><form class="search"><input name="search" value="@Model.Search" placeholder="Search title/headline/content/source"/><button>Search</button></form><button onclick="openDlg('create')">+ Create news</button></div>
<table><thead><tr><th>ID</th><th>Title</th><th>Category</th><th>Status</th><th>Created</th><th>Tags</th><th>Actions</th></tr></thead><tbody>@foreach(var n in Model.News){<tr><td>@n.NewsArticleId</td><td><strong>@n.NewsTitle</strong><div class="muted">@n.Headline</div></td><td>@n.Category?.CategoryName</td><td>@(n.NewsStatus?"Active":"Inactive")</td><td>@n.CreatedDate?.ToString("dd/MM/yyyy")</td><td>@string.Join(", ",n.Tags.Select(t=>t.TagName))</td><td><button onclick="openDlg('e@n.NewsArticleId')">Edit</button><form class="inline" method="post" asp-action="Delete" onsubmit="return confirmDelete()"><input type="hidden" name="id" value="@n.NewsArticleId"/><button class="danger">Delete</button></form></td></tr>
<dialog id="e@n.NewsArticleId"><form method="post" asp-action="Edit"><input type="hidden" name="NewsArticleId" value="@n.NewsArticleId"/><h2>Edit news</h2><label>Title<input name="NewsTitle" value="@n.NewsTitle" maxlength="400"/></label><label>Headline<input name="Headline" value="@n.Headline" required maxlength="150"/></label><label>Content<textarea name="NewsContent" maxlength="4000">@n.NewsContent</textarea></label><label>Source<input name="NewsSource" value="@n.NewsSource" maxlength="400"/></label><label>Category<select name="CategoryId" required>@foreach(var c in Model.Categories){<option value="@c.CategoryId" selected="@(n.CategoryId==c.CategoryId ? "selected" : null)">@c.CategoryName</option>}</select></label><label class="check"><input type="checkbox" name="NewsStatus" value="true" checked="@(n.NewsStatus ? "checked" : null)"/> Active</label><fieldset><legend>Tags</legend>@foreach(var t in Model.Tags){<label class="check"><input type="checkbox" name="TagIds" value="@t.TagId" checked="@(n.Tags.Any(x=>x.TagId==t.TagId) ? "checked" : null)"/> @t.TagName</label>}</fieldset><div class="dlg-actions"><button type="button" onclick="closeDlg('e@n.NewsArticleId')">Cancel</button><button>Save</button></div></form></dialog>}
</tbody></table>
<dialog id="create"><form method="post" asp-action="Create"><h2>Create news</h2><label>Title<input name="NewsTitle" maxlength="400"/></label><label>Headline<input name="Headline" required maxlength="150"/></label><label>Content<textarea name="NewsContent" maxlength="4000"></textarea></label><label>Source<input name="NewsSource" maxlength="400"/></label><label>Category<select name="CategoryId" required>@foreach(var c in Model.Categories.Where(x=>x.IsActive)){<option value="@c.CategoryId">@c.CategoryName</option>}</select></label><label class="check"><input type="checkbox" name="NewsStatus" value="true" checked/> Active</label><fieldset><legend>Tags</legend>@foreach(var t in Model.Tags){<label class="check"><input type="checkbox" name="TagIds" value="@t.TagId"/> @t.TagName</label>}</fieldset><div class="dlg-actions"><button type="button" onclick="closeDlg('create')">Cancel</button><button>Create</button></div></form></dialog>
