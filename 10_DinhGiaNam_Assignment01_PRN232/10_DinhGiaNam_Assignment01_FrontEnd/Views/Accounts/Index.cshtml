@model List<AccountVm>
<h1>Account Management</h1><div class="toolbar"><form class="search"><input name="search" value="@ViewBag.Search" placeholder="Search name/email"/><button>Search</button></form><button onclick="openDlg('create')">+ Create account</button></div>
<table><thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Role</th><th>Actions</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.AccountId</td><td>@a.AccountName</td><td>@a.AccountEmail</td><td>@(a.AccountRole==1?"Staff":"Lecturer")</td><td><button onclick="openDlg('e@a.AccountId')">Edit</button><form class="inline" method="post" asp-action="Delete" onsubmit="return confirmDelete()"><input type="hidden" name="id" value="@a.AccountId"/><button class="danger">Delete</button></form></td></tr>
<dialog id="e@a.AccountId"><form method="post" asp-action="Edit"><input type="hidden" name="AccountId" value="@a.AccountId"/><h2>Edit account</h2><label>Name<input name="AccountName" value="@a.AccountName" required maxlength="100"/></label><label>Email<input type="email" name="AccountEmail" value="@a.AccountEmail" required/></label><label>Role<select name="AccountRole"><option value="1" selected="@(a.AccountRole==1 ? "selected" : null)">Staff</option><option value="2" selected="@(a.AccountRole==2 ? "selected" : null)">Lecturer</option></select></label><label>Password<input name="AccountPassword" value="@a.AccountPassword" required/></label><div class="dlg-actions"><button type="button" onclick="closeDlg('e@a.AccountId')">Cancel</button><button>Save</button></div></form></dialog>}
</tbody></table>
<dialog id="create"><form method="post" asp-action="Create"><h2>Create account</h2><label>Name<input name="AccountName" required maxlength="100"/></label><label>Email<input type="email" name="AccountEmail" required/></label><label>Role<select name="AccountRole"><option value="1">Staff</option><option value="2">Lecturer</option></select></label><label>Password<input name="AccountPassword" required/></label><div class="dlg-actions"><button type="button" onclick="closeDlg('create')">Cancel</button><button>Create</button></div></form></dialog>
